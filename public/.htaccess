<IfModule mod_rewrite.c>
	RewriteEngine On

	# The form posts to /api/partner, which is served by the PHP proxy
	RewriteRule ^api/partner$ api/partner.php [L]

	# Single-page app: serve index.html for any path that isn't a real file or folder
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]
</IfModule>
